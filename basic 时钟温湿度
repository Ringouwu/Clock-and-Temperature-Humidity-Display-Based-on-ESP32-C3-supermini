#include <Wire.h>
#include <DHT.h>
#include <RTClib.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

#define SDA_PIN 8
#define SCL_PIN 9
#define DHT_PIN 4
#define DHT_TYPE DHT22

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_ADDRESS 0x3C

DHT dht(DHT_PIN, DHT_TYPE);
RTC_DS3231 rtc;
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

void setup() {
  Serial.begin(115200);

  Wire.begin(SDA_PIN, SCL_PIN);
  dht.begin();

  if (!rtc.begin()) {
    Serial.println("找不到 DS3231 时钟模块");
    while (true);
  }

  // 只在第一次设置时间时取消下一行的注释并上传一次。
  // 设置完成后，重新注释掉这一行，再上传一次。
  // rtc.adjust(DateTime(F(__DATE__), F(__TIME__)));

  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDRESS)) {
    Serial.println("找不到 OLED 屏幕");
    while (true);
  }

  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
}

void loop() {
  DateTime now = rtc.now();
  float humidity = dht.readHumidity();
  float temperature = dht.readTemperature();

  display.clearDisplay();

  // 时间
  display.setTextSize(2);
  display.setCursor(15, 0);

  char timeText[12];
  snprintf(timeText, sizeof(timeText), "%02d:%02d:%02d",
           now.hour(), now.minute(), now.second());
  display.print(timeText);

  // 日期
  display.setTextSize(1);
  display.setCursor(25, 22);

  char dateText[16];
  snprintf(dateText, sizeof(dateText), "%04d-%02d-%02d",
           now.year(), now.month(), now.day());
  display.print(dateText);

  // 温湿度
  display.setCursor(5, 40);
  if (isnan(temperature) || isnan(humidity)) {
    display.print("DHT22 read error");
  } else {
    display.print("Temp: ");
    display.print(temperature, 1);
    display.print(" C");

    display.setCursor(5, 53);
    display.print("Humi: ");
    display.print(humidity, 1);
    display.print(" %");
  }

  display.display();
  delay(2000);
}
